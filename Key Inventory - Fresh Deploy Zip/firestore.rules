rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // a person's own account details, and the friend requests sent to them
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /invites/{from} {
        allow create: if request.auth != null && request.auth.uid == from;
        allow read, delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == from);
      }
    }

    // finding a friend by their email (one at a time, there is no list)
    match /emails/{h} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // a band's songs, setlists, singer pictures, members, who is playing, play invitations and play chat
    match /workspaces/{band}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
